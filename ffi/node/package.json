{
  "name": "@withautonomi/ant-sdk",
  "version": "0.0.9",
  "description": "Direct-network (daemon-less) Autonomi client for Node.js and Electron — native addon over the Rust ant-ffi core.",
  "author": "Autonomi",
  "license": "MIT OR Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "main": "index.js",
  "types": "index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WithAutonomi/ant-sdk.git",
    "directory": "ffi/node"
  },
  "keywords": [
    "autonomi",
    "ant",
    "storage",
    "web3",
    "napi-rs",
    "native"
  ],
  "engines": {
    "node": ">= 16"
  },
  "napi": {
    "binaryName": "ant-sdk",
    "targets": [
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl"
    ]
  },
  "files": [
    "index.js",
    "index.d.ts"
  ],
  "scripts": {
    "artifacts": "napi artifacts",
    "build": "napi build --platform --release --no-const-enum",
    "build:debug": "napi build --platform --no-const-enum",
    "prepublishOnly": "napi prepublish -t npm --no-gh-release",
    "test": "node --test",
    "version": "napi version",
    "typecheck": "tsc -p __test__/tsconfig.json"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.8.5",
    "@types/node": "^22.20.2",
    "typescript": "^5.6.0"
  }
}
