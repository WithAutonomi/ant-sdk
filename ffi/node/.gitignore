# Rust build output
target/

# Node
node_modules/

# napi-rs native build output (per-platform; shipped via the platform packages)
*.node
# NOTE: index.js + index.d.ts are generated by `napi build` but COMMITTED — they
# are the root package's entry points and must be in the published tarball. CI
# fails if a fresh build drifts from the committed copies.

# Generated per-platform npm packages (created by `napi create-npm-dirs` / prepublish)
npm/
# Downloaded CI artifacts staging dir (publish workflow)
artifacts/
