<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>AntFfi</RootNamespace>
    <AssemblyName>AntFfi</AssemblyName>
  </PropertyGroup>

  <!-- NuGet package metadata. Published as Autonomi.Ffi by publish-nuget-ffi.yml on
       nuget-ffi-v* tags. <Version> MUST equal the ant-ffi crate version
       (ffi/rust/ant-ffi/Cargo.toml): the workflow asserts tag == Version ==
       crate version == AntFfiVersion() at runtime. -->
  <PropertyGroup>
    <PackageId>Autonomi.Ffi</PackageId>
    <Version>0.0.9</Version>
    <Authors>Autonomi</Authors>
    <Company>Autonomi</Company>
    <Description>Direct-network .NET client for the Autonomi decentralized network: UniFFI bindings over the ant-ffi Rust crate, with the native library bundled for win-x64, win-arm64, linux-x64, linux-arm64, osx-x64 and osx-arm64. No daemon required; for the daemon-backed client see Autonomi.Antd.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/WithAutonomi/ant-sdk/tree/main/ffi/csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WithAutonomi/ant-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>autonomi;ant-ffi;decentralized;storage;client;native;uniffi</PackageTags>
    <PackageReleaseNotes>https://github.com/WithAutonomi/ant-sdk/releases</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <!-- The C# surface is generated by uniffi-bindgen-cs and carries no XML
         doc comments; do not spam CS1591 or fail the build over it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- Generated bindings (uniffi-bindgen-cs, see ffi/scripts/build.sh) live in
       Generated/ and are picked up by the SDK default Compile glob. -->

  <!-- Native libraries, one per RID, laid out as
         runtimes/<rid>/native/{ant_ffi.dll|libant_ffi.so|libant_ffi.dylib}
       The NuGet RID graph picks the right one at restore time for consumers. -->
  <ItemGroup>
    <None Include="runtimes/**/native/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

  <!-- Dev-time convenience: copy the current host's native library next to
       the build output so ProjectReference consumers (the tests) can load it
       without a RID-specific publish. -->
  <ItemGroup>
    <None Include="runtimes/$(NETCoreSdkRuntimeIdentifier)/native/*" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
    <None Include="../LICENSE-MIT" Pack="true" PackagePath="/" />
    <None Include="../LICENSE-APACHE" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
