<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Antd.Sdk</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- NuGet package metadata (published as Autonomi.Antd by publish-nuget.yml on
       nuget-v* tags; the Version below must equal the tag suffix). -->
  <PropertyGroup>
    <PackageId>Autonomi.Antd</PackageId>
    <Version>0.1.0</Version>
    <Authors>Autonomi</Authors>
    <Company>Autonomi</Company>
    <Description>.NET client for the antd daemon: store and fetch data on the Autonomi decentralized network over REST or gRPC. Requires a running antd daemon.</Description>
    <PackageLicenseExpression>MIT OR Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/WithAutonomi/ant-sdk/tree/main/antd-csharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/WithAutonomi/ant-sdk</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>autonomi;antd;decentralized;storage;client;grpc</PackageTags>
    <PackageReleaseNotes>https://github.com/WithAutonomi/ant-sdk/releases</PackageReleaseNotes>
    <!-- Reproducible, debuggable package: SourceLink (bundled with the .NET 8
         SDK), embedded untracked sources, portable symbols in a .snupkg. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- CS1591: missing XML doc comments — public surface is documented in
         README/llms.txt; don't fail or spam the build over undocumented members. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE-MIT" Pack="true" PackagePath="\" />
    <None Include="..\LICENSE-APACHE" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.76.0" />
    <PackageReference Include="Grpc.Tools" Version="2.78.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\antd\proto\antd\v1\health.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
    <Protobuf Include="..\..\antd\proto\antd\v1\common.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
    <Protobuf Include="..\..\antd\proto\antd\v1\data.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
    <Protobuf Include="..\..\antd\proto\antd\v1\chunks.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
    <Protobuf Include="..\..\antd\proto\antd\v1\files.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
    <Protobuf Include="..\..\antd\proto\antd\v1\events.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
    <Protobuf Include="..\..\antd\proto\antd\v1\upload.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
    <Protobuf Include="..\..\antd\proto\antd\v1\wallet.proto" ProtoRoot="..\..\antd\proto" GrpcServices="Client" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Antd.Sdk.Tests" />
  </ItemGroup>

</Project>
