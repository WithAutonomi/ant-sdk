{
  "name": "@withautonomi/antd",
  "version": "0.2.0",
  "description": "JavaScript/TypeScript SDK for the Autonomi network via the antd daemon",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "autonomi",
    "antd",
    "decentralized",
    "network",
    "sdk"
  ],
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WithAutonomi/ant-sdk.git",
    "directory": "antd-js"
  },
  "homepage": "https://github.com/WithAutonomi/ant-sdk/tree/main/antd-js#readme",
  "bugs": {
    "url": "https://github.com/WithAutonomi/ant-sdk/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "ethers": "^6.13.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  }
}
